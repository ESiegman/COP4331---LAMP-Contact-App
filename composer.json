{
    "name": "esiegman/cop4331-lamp-contact-app",
    "description": "Contacts Manager LAMP API",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "api/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "test:local": "sh -c 'set -a; [ -f .env ] && . ./.env; set +a; DB_HOST=127.0.0.1 DB_NAME=ContactsAppDB_test DB_USER=ContactsAppUser vendor/bin/phpunit'"
    }
}
